---
import credits from '../data/credits.json';
interface Props {
  name: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  credit?: boolean;
  class?: string;
  position?: string;
  [key: string]: any;
}
const { name, alt, sizes = '100vw', eager = false, credit = true, class: cls = '', position, ...rest } = Astro.props;
const c = credits.find((x) => x.file === name);
---
<img
  src={`/img/${name}-1600.webp`}
  srcset={`/img/${name}-800.webp 800w, /img/${name}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={cls}
  style={position ? `object-position:${position}` : undefined}
  {...rest}
/>
{credit && c && (
  <a class="credit" href={`/bildnachweise#${c.file}`} title={`${c.author}, ${c.license}`}>
    Foto: {c.author} · {c.license}
  </a>
)}
