---
import Img from './Img.astro';
import { districts } from '../data/site';
---
<section class="section area">
  <div class="wrap area__grid">
    <div class="area__copy">
      <p class="eyebrow" data-reveal>Einzugsgebiet</p>
      <h2 class="h2" data-split>Hamburg West und Nord. Von <em>Lokstedt</em> aus.</h2>
      <p class="body" data-reveal>Unsere Baustellen liegen überwiegend im Hamburger Westen und Norden. Weiter entfernte Objekte nehmen wir an, wenn der Umfang passt.</p>

      <form class="plz" data-plz data-reveal onsubmit="return false">
        <label for="plz-input" class="plz__label">Postleitzahl prüfen</label>
        <div class="plz__row">
          <input id="plz-input" inputmode="numeric" maxlength="5" placeholder="z. B. 20251" autocomplete="postal-code" data-plz-input />
          <span class="plz__state" data-plz-state aria-hidden="true"></span>
        </div>
        <p class="plz__out" data-plz-out aria-live="polite">Fünf Ziffern eingeben, wir sagen Ihnen sofort Bescheid.</p>
      </form>
    </div>
    <div class="area__media media media--parallax" data-parallax="8" data-reveal="fade">
      <Img name="blankenese" alt="Blick über Blankenese und die Elbe" sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
  </div>
  <div class="marquee area__marquee" aria-label="Stadtteile">
    {[0, 1].map((n) => (
      <ul class="marquee__track" aria-hidden={n === 1 ? 'true' : undefined}>
        {districts.map((d) => <li>{d}</li>)}
      </ul>
    ))}
  </div>
</section>

<style>
  .area__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 110px); align-items: center; }
  .area__copy { display: grid; gap: 22px; }
  .area__media { aspect-ratio: 4 / 3.2; }
  .plz { margin-top: 12px; padding: 22px; border-radius: 22px; background: var(--ink); color: #fff; max-width: 460px; }
  .plz__label { display: block; font-weight: 700; margin-bottom: 8px; }
  .plz__row { position: relative; }
  .plz input { width: 100%; font-size: 2.2rem; font-weight: 800; letter-spacing: 0.08em; padding: 6px 56px 6px 0; border: 0; border-bottom: 2px solid rgba(255,255,255,.3); background: transparent; color: #fff; }
  .plz input::placeholder { color: rgba(255,255,255,.35); }
  .plz input:focus { outline: none; border-color: var(--peach); }
  .plz__state { position: absolute; right: 4px; top: 50%; width: 34px; height: 34px; margin-top: -17px; border-radius: 50%; background: rgba(255,255,255,.12); transition: all 0.4s var(--ease-out); }
  .plz[data-result='yes'] .plz__state { background: var(--green); transform: scale(1.15); }
  .plz[data-result='maybe'] .plz__state { background: var(--peach); }
  .plz[data-result='far'] .plz__state { background: #666; }
  .plz__out { margin-top: 12px; font-size: 0.95rem; color: rgba(255,255,255,.75); min-height: 2.8em; }
  .plz__out :global(strong) { color: #fff; }
  .area__marquee { margin-top: clamp(56px, 8vw, 110px); font-weight: 800; letter-spacing: -0.05em; font-size: clamp(2.6rem, 6vw, 5.4rem); line-height: 1.1; --marquee-speed: 60s; }
  .area__marquee li { white-space: nowrap; }
  .area__marquee li:nth-child(3n+1) { background: var(--peach); padding: 0 0.15em; border-radius: 0.12em; }
  .area__marquee li:nth-child(3n+2) { color: #c9c9c4; }
  @media (max-width: 900px) { .area__grid { grid-template-columns: 1fr; } }
</style>

<script>
  // Postleitzahl-Zuordnung: Kerngebiet Hamburg West/Nord, übriges Hamburg & Umland, alles andere.
  const core: [number, number][] = [
    [20144, 20149], [20249, 20259], [22081, 22085], [22297, 22309], [22453, 22459], [22523, 22529], [22547, 22549],
    [22587, 22589], [22605, 22609], [22761, 22769], [22844, 22851], [22869, 22869], [25421, 25421], [25469, 25469],
  ];
  const near = [[20000, 21149], [22000, 22999], [25400, 25499], [21400, 21529]];
  const inR = (n: number, r: number[][]) => r.some(([a, b]) => n >= a && n <= b);
  document.querySelectorAll<HTMLFormElement>('[data-plz]').forEach((f) => {
    const input = f.querySelector<HTMLInputElement>('[data-plz-input]')!;
    const out = f.querySelector<HTMLElement>('[data-plz-out]')!;
    const initial = out.textContent;
    input.addEventListener('input', () => {
      input.value = input.value.replace(/\D/g, '').slice(0, 5);
      const v = input.value;
      if (v.length < 5) { f.dataset.result = ''; out.textContent = initial; return; }
      const n = parseInt(v, 10);
      if (inR(n, core)) { f.dataset.result = 'yes'; out.innerHTML = `<strong>${v} liegt in unserem Kerngebiet.</strong> Kurze Wege von Lokstedt aus.`; }
      else if (inR(n, near)) { f.dataset.result = 'maybe'; out.innerHTML = `<strong>${v}: In Hamburg und Umgebung.</strong> Fragen Sie einfach. Wir sagen ehrlich, ob es passt.`; }
      else { f.dataset.result = 'far'; out.innerHTML = `<strong>${v} liegt außerhalb unseres Gebiets.</strong> Bei größeren Projekten fragen Sie trotzdem gern.`; }
    });
  });
</script>
