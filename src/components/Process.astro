---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  steps: { title: string; meta?: string; text: string }[];
  note?: string;
}
const { eyebrow, title, intro, steps, note } = Astro.props;
---
<section class="section process" data-progress-host>
  <div class="wrap process__grid">
    <div class="process__side">
      <div class="process__sticky">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
        <h2 class="h2" data-split set:html={title} />
        {intro && <p class="lead" data-reveal>{intro}</p>}
        {note && <p class="process__note" data-reveal>{note}</p>}
      </div>
    </div>
    <ol class="process__list">
      <div class="process__line" data-progress-line aria-hidden="true"><span data-progress-fill></span></div>
      {steps.map((s, i) => (
        <li class="process__step" data-progress-step>
          <span class="process__node" aria-hidden="true"></span>
          <span class="process__num tnum">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="h3">{s.title}</h3>
            {s.meta && <p class="process__meta">{s.meta}</p>}
            <p class="body">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 120px); }
  .process__sticky { position: sticky; top: calc(var(--nav-h) + 40px); display: grid; gap: 20px; }
  .process__note { font-weight: 650; padding: 10px 16px; border-radius: 999px; background: var(--hl); color: var(--hl-ink); width: fit-content; }
  .process__list { position: relative; display: grid; gap: 10px; }
  .process__line, .process__node { display: none; }
  .process__step { position: relative; display: grid; grid-template-columns: 72px 1fr; gap: 20px; padding: 24px; border-radius: 22px; background: var(--grey); transition: background 0.5s var(--ease-out), color 0.5s; }
  .process__step.is-active { background: var(--ink); color: #fff; --muted: rgba(255,255,255,.72); }
  .world-water .process__step.is-active { background: var(--blue); }
  .process__num { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--ink); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.04em; transition: background 0.5s, transform 0.6s var(--ease-out); }
  .process__step.is-active .process__num { background: var(--peach); transform: rotate(-8deg); }
  .world-water .process__step.is-active .process__num { background: #fff; color: var(--blue); }
  .process__step .h3 { margin-bottom: 6px; }
  .process__meta { font-weight: 700; font-size: 0.9rem; margin-bottom: 8px; color: var(--muted); }
  @media (max-width: 900px) {
    .process__grid { grid-template-columns: 1fr; }
    .process__sticky { position: static; }
    .process__step { grid-template-columns: 1fr; }
    .process__num { width: 56px; height: 56px; font-size: 1.2rem; }
  }
</style>
