---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<header class="phead">
  <div class="wrap">
    <p class="phead__eyebrow" data-reveal>{eyebrow}</p>
    <h1 class="h1 phead__title" data-split="now" set:html={title} />
    {lead && <p class="lead phead__lead" data-reveal style="--d:.15s">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .phead { padding: calc(var(--nav-h) + clamp(48px, 6vw, 96px)) 0 clamp(40px, 5vw, 72px); }
  .phead__eyebrow { font-weight: 650; margin-bottom: 18px; }
  .phead__title { max-width: 16ch; font-size: clamp(2.8rem, 1.4rem + 4.8vw, 6.6rem); }
  .phead__lead { margin-top: 28px; color: var(--ink); font-weight: 500; max-width: 48ch; }
</style>
