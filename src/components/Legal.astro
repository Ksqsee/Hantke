---
interface Props { title: string; intro: string; stand: string; sections: { h: string; p: string[] }[] }
const { title, intro, stand, sections } = Astro.props;
---
<section class="legal">
  <div class="wrap legal__grid">
    <aside class="legal__side">
      <p class="legal__eyebrow">Rechtliches</p>
      <h1 class="h1 legal__title">{title}</h1>
      <p class="body">{intro}</p>
      <p class="legal__stand">Stand {stand}</p>
      <nav class="legal__toc" aria-label="Inhalt">
        {sections.map((s, i) => <a href={`#s${i + 1}`}><span class="tnum">{String(i + 1).padStart(2, '0')}</span>{s.h}</a>)}
      </nav>
    </aside>
    <div class="legal__body">
      {sections.map((s, i) => (
        <section id={`s${i + 1}`} class="legal__sec">
          <h2 class="h3"><span class="tnum">{String(i + 1).padStart(2, '0')}</span>{s.h}</h2>
          {s.p.map((x) => <p set:html={x} />)}
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .legal { padding: calc(var(--nav-h) + clamp(48px, 6vw, 96px)) 0 clamp(80px, 10vw, 140px); }
  .legal__grid { display: grid; grid-template-columns: 4fr 7fr; gap: clamp(32px, 6vw, 110px); }
  .legal__side { position: sticky; top: calc(var(--nav-h) + 32px); align-self: start; display: grid; gap: 16px; }
  .legal__eyebrow { font-weight: 650; }
  .legal__title { font-size: clamp(2.6rem, 1.6rem + 3vw, 4.6rem); }
  .legal__stand { font-weight: 650; padding: 6px 12px; border-radius: 999px; background: var(--peach); width: fit-content; font-size: 0.9rem; }
  .legal__toc { display: grid; gap: 2px; margin-top: 12px; font-size: 0.92rem; font-weight: 600; }
  .legal__toc a { display: flex; gap: 12px; padding: 6px 10px; border-radius: 10px; }
  .legal__toc a:hover { background: var(--grey); }
  .legal__toc span { color: var(--ink-3); }
  .legal__sec { padding: 28px 0; border-bottom: 2px solid var(--grey); display: grid; gap: 12px; }
  .legal__sec:first-child { padding-top: 0; }
  .legal__sec h2 { display: flex; gap: 14px; }
  .legal__sec h2 span { color: var(--ink-3); }
  .legal__sec p { color: var(--ink-2); max-width: 68ch; }
  .legal__sec :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .legal__sec :global(mark) { background: var(--peach); padding: 0 4px; border-radius: 3px; color: var(--ink); }
  @media (max-width: 900px) { .legal__grid { grid-template-columns: 1fr; } .legal__side { position: static; } .legal__toc { display: none; } }
</style>
