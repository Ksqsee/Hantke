---
// Flat to-do list (Todoist / Numo pattern on Mobbin): round checkbox, title, one line, time on the right.
import Icon from './Icon.astro';
import { phones } from '../data/site';
const steps = [
  { when: 'sofort', title: 'Wasser abstellen', text: 'Eckventil am Gerät, sonst Haupthahn.' },
  { when: 'sofort', title: 'Strom sichern', text: 'Wasser an Steckdosen? Sicherung raus.' },
  { when: 'vor dem Aufräumen', title: 'Fotos machen', text: 'Für die Versicherung. Handy reicht.' },
  { when: 'erste Stunde', title: 'Wasser aufnehmen', text: 'Aufwischen, Möbel hoch, Teppiche raus.' },
  { when: 'heute', title: 'Versicherung melden', text: 'Schadennummer notieren. Dann uns anrufen.' },
];
const donts = ['Heizung hochdrehen', 'Boden selbst aufreißen', 'Gleich überstreichen'];
---
<section class="section todo" id="sofort">
  <div class="wrap todo__grid">
    <div class="todo__head">
      <h2 class="h2" data-split>Jetzt <em>sofort.</em></h2>
      <p class="lead" data-reveal>Fünf Dinge, bevor wir da sind.</p>
      <div class="todo__dont" data-reveal>
        <p class="todo__dont-title">Besser nicht:</p>
        <ul>{donts.map((d) => <li><Icon name="x" size={16} />{d}</li>)}</ul>
      </div>
    </div>

    <div class="todo__list" data-checklist data-reveal>
      <p class="todo__count"><span class="tnum" data-check-count>0</span> von {steps.length} erledigt</p>
      <ul>
        {steps.map((s) => (
          <li>
            <label class="task">
              <input type="checkbox" data-check />
              <span class="task__box" aria-hidden="true"><Icon name="check" size={16} /></span>
              <span class="task__body">
                <span class="task__title">{s.title}</span>
                <span class="task__text">{s.text}</span>
              </span>
              <span class="task__when">{s.when}</span>
            </label>
          </li>
        ))}
      </ul>
      <a href={phones.wasser.href} class="btn btn--blue btn--lg todo__call" data-check-done hidden><Icon name="phone" class="btn__icon" /> Erledigt. Jetzt anrufen: {phones.wasser.display}</a>
    </div>
  </div>
</section>

<style>
  .todo__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 110px); align-items: start; }
  .todo__head { display: grid; gap: 20px; position: sticky; top: calc(var(--nav-h) + 32px); }
  .todo__dont { margin-top: 12px; }
  .todo__dont-title { font-weight: 800; margin-bottom: 8px; }
  .todo__dont li { display: flex; align-items: center; gap: 10px; padding: 6px 0; font-weight: 600; color: var(--ink-2); }
  .todo__dont :global(svg) { color: #d4380d; stroke-width: 2.4; }
  .todo__count { font-weight: 700; padding-bottom: 14px; border-bottom: 2px solid var(--ink); }
  .task { display: grid; grid-template-columns: 36px 1fr auto; gap: 18px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); cursor: pointer; }
  .task input { position: absolute; opacity: 0; pointer-events: none; }
  .task__box { width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--ink); display: grid; place-items: center; color: transparent; transition: background 0.2s, border-color 0.2s, transform 0.3s var(--ease-out); }
  .task__box :global(svg) { stroke-width: 3; }
  .task:hover .task__box { border-color: var(--blue); }
  .task input:checked ~ .task__box { background: var(--blue); border-color: var(--blue); color: #fff; transform: scale(1.06); }
  .task input:focus-visible ~ .task__box { outline: 2px solid var(--blue); outline-offset: 3px; }
  .task__body { display: grid; gap: 2px; min-width: 0; }
  .task__title { font-size: var(--step-2); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; transition: color 0.2s; }
  .task__text { color: var(--ink-2); }
  .task__when { font-size: 0.9rem; font-weight: 650; color: var(--blue); white-space: nowrap; }
  .task input:checked ~ .task__body .task__title { color: var(--ink-3); text-decoration: line-through; text-decoration-thickness: 3px; }
  .task input:checked ~ .task__body .task__text, .task input:checked ~ .task__when { color: var(--ink-3); }
  .todo__call { margin-top: 24px; }
  @media (max-width: 900px) {
    .todo__grid { grid-template-columns: 1fr; }
    .todo__head { position: static; }
    .todo__dont { order: 3; }
  }
  @media (max-width: 520px) {
    .task { grid-template-columns: 32px 1fr; gap: 14px; }
    .task__box { width: 30px; height: 30px; }
    .task__when { grid-column: 2; font-size: 0.82rem; }
    .todo__call { width: 100%; white-space: normal; height: auto; padding: 16px 20px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-checklist]').forEach((list) => {
    const boxes = list.querySelectorAll<HTMLInputElement>('[data-check]');
    const count = list.querySelector<HTMLElement>('[data-check-count]')!;
    const done = list.querySelector<HTMLElement>('[data-check-done]')!;
    list.addEventListener('change', () => {
      const n = Array.from(boxes).filter((b) => b.checked).length;
      count.textContent = String(n);
      done.hidden = n !== boxes.length;
    });
  });
</script>
