---
import Icon from './Icon.astro';
import { company } from '../data/site';
interface Props { world?: 'warm' | 'water' }
const { world = 'warm' } = Astro.props;
const ours = world === 'water'
  ? ['Messen', 'Geräte stellen', 'Protokollieren', 'Mit der Versicherung sprechen', 'Abbauen', 'Spachteln', 'Streichen', 'Abnahme']
  : ['Abdecken', 'Abkleben', 'Untergrund prüfen', 'Spachteln', 'Streichen', 'Aufräumen', 'Abnahme'];
---
<section class="section value">
  <div class="wrap">
    <div class="value__head">
      <p class="eyebrow" data-reveal>Das Angebot</p>
      <h2 class="h2" data-split>Viel Ergebnis. <em class="hl-blue">Wenig Aufwand.</em></h2>
    </div>

    <div class="value__grid">
      <article class="vcard" data-reveal data-inview>
        <p class="vcard__tag">01 · Ergebnis</p>
        <div class="vis vis-wall" aria-hidden="true">
          <div class="vis-wall__stain"></div>
          <div class="vis-wall__paint"></div>
          <div class="vis-wall__roller"><Icon name="roller" size={22} /></div>
          <span class="vis-wall__label" data-wall-label>Vorher</span>
        </div>
        <h3 class="h3">{world === 'water' ? 'Am Ende sieht man der Wand nichts mehr an.' : 'Kanten, die auch beim dritten Raum sitzen.'}</h3>
        <p class="body">{world === 'water' ? 'Trocknung und malermäßige Wiederherstellung aus einem Betrieb. Bis die Fläche wieder aussieht wie vorher.' : 'Von der schnellen Renovierung der Mietwohnung bis zur Spachteltechnik im Altbau. Von Einfach bis Edel.'}</p>
      </article>

      <article class="vcard" data-reveal style="--d:.08s" data-inview>
        <p class="vcard__tag">02 · Sicherheit</p>
        <ul class="vis vis-reg" aria-label="Nachweise">
          <li><span>Handelsregister</span><span>{company.hrb}</span><Icon name="check" size={14} /></li>
          <li><span>Handwerkskammer</span><span>Nr. {company.hwkNumber}</span><Icon name="check" size={14} /></li>
          <li><span>Meisterbetrieb</span><span>seit {company.founded}</span><Icon name="check" size={14} /></li>
          <li><span>Google</span><span>5,0 / 5</span><Icon name="check" size={14} /></li>
        </ul>
        <h3 class="h3">Nachprüfbar statt versprochen.</h3>
        <p class="body">Kein Vermittlungsportal, keine Subunternehmerkette. Eigene Werkstatt am Bötelkamp in Lokstedt.</p>
      </article>

      <article class="vcard" data-reveal style="--d:.16s" data-inview>
        <p class="vcard__tag">03 · Zeit</p>
        <div class="vis vis-time" aria-hidden="true">
          <div class="vis-time__row"><span class="vis-time__dot"></span><span class="mono">Ihre Anfrage</span><span class="mono vis-time__t" data-now-time>jetzt</span></div>
          <div class="vis-time__line"><span></span></div>
          <div class="vis-time__row"><span class="vis-time__dot vis-time__dot--on"></span><span class="mono">Rückmeldung</span><span class="mono vis-time__t" data-reply-day>selber Werktag</span></div>
        </div>
        <h3 class="h3">{world === 'water' ? 'Je früher gemessen wird, desto kleiner der Schaden.' : 'Rückmeldung am selben Werktag.'}</h3>
        <p class="body">{world === 'water' ? 'Werktags erreichbar. Auf jede Anfrage gibt es eine Rückmeldung, auch wenn wir gerade keine Kapazität haben.' : 'Spätestens am nächsten. Das schriftliche Angebot kommt, bevor wir anfangen. Nicht danach.'}</p>
      </article>

      <article class="vcard" data-reveal style="--d:.24s" data-inview>
        <p class="vcard__tag">04 · Ihr Aufwand</p>
        <div class="vis vis-effort" aria-hidden="true">
          <div class="vis-effort__col">
            <span class="mono vis-effort__who">Sie</span>
            <span class="chipx chipx--you"><Icon name="camera" size={13} /> Foto</span>
            <span class="chipx chipx--you"><Icon name="phone" size={13} /> Anruf</span>
          </div>
          <div class="vis-effort__col vis-effort__col--us">
            <span class="mono vis-effort__who">Wir</span>
            {ours.map((o, i) => <span class="chipx" style={`--i:${i}`}>{o}</span>)}
          </div>
        </div>
        <h3 class="h3">Sie machen ein Foto. Den Rest machen wir.</h3>
        <p class="body">{world === 'water' ? 'Messprotokoll und Trocknungsbericht für die Versicherung bekommen Sie von uns. Ohne Nachfragen.' : 'Folie und Vlies auf dem Boden, Leisten abgeklebt, am Ende jedes Tages aufgeräumt.'}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .value__head { display: grid; gap: 20px; max-width: 1000px; margin-bottom: clamp(40px, 5vw, 72px); }
  .value__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .vcard { display: flex; flex-direction: column; gap: 14px; padding: 22px; border-radius: 24px; min-height: 540px; transition: transform 0.4s var(--ease-out); }
  .vcard:nth-child(1) { background: var(--peach); color: var(--ink); --muted: rgba(0,0,0,.7); }
  .vcard:nth-child(2) { background: var(--grey); }
  .vcard:nth-child(3) { background: var(--ink); color: #fff; --muted: rgba(255,255,255,.72); }
  .vcard:nth-child(4) { background: var(--blue); color: #fff; --muted: rgba(255,255,255,.78); }
  .vcard:hover { transform: translateY(-4px); }
  .vcard .h3 { font-size: var(--step-2); margin-top: auto; letter-spacing: -0.035em; }
  .vcard .body { font-size: 0.98rem; color: var(--muted); }
  .vcard__tag { font-size: 0.9rem; font-weight: 700; }
  .vis { position: relative; height: 210px; border-radius: 16px; background: #fff; color: var(--ink); overflow: hidden; margin-bottom: 8px; }

  .vis-wall { background: #f1ebe3; }
  .vis-wall__stain { position: absolute; left: 16%; top: 26%; width: 66%; height: 74%; border-radius: 48% 52% 40% 60% / 60% 40% 60% 40%; background: radial-gradient(ellipse at 50% 80%, rgba(110, 86, 60, 0.6), rgba(140, 112, 80, 0.28) 55%, transparent 72%); }
  .vis-wall__paint { position: absolute; inset: 0; background: #fff; clip-path: inset(0 100% 0 0); transition: clip-path 2s var(--ease-in-out) 0.4s; }
  .vis-wall__roller { position: absolute; top: 50%; left: 0; width: 46px; height: 46px; margin-top: -23px; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; transform: translateX(-60px); transition: transform 2s var(--ease-in-out) 0.4s; z-index: 1; }
  .is-inview .vis-wall__paint { clip-path: inset(0 0 0 0); }
  .is-inview .vis-wall__roller { transform: translateX(calc(var(--w, 260px) - 58px)); }
  .vis-wall__label { position: absolute; left: 12px; bottom: 10px; font-size: 0.8rem; font-weight: 700; padding: 4px 9px; border-radius: 999px; background: var(--ink); color: #fff; z-index: 1; }

  .vis-reg { display: grid; align-content: center; padding: 10px 16px; font-size: 0.85rem; }
  .vis-reg li { display: grid; grid-template-columns: 1fr auto 22px; gap: 8px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); color: var(--ink-2); }
  .vis-reg li:last-child { border-bottom: 0; }
  .vis-reg li span:nth-child(2) { color: var(--ink); font-weight: 700; }
  .vis-reg li :global(svg) { width: 22px; height: 22px; padding: 4px; border-radius: 50%; background: var(--green); color: #fff; stroke-width: 2.6; opacity: 0; transform: scale(0.3); transition: all 0.45s var(--ease-out); }
  .is-inview .vis-reg li :global(svg) { opacity: 1; transform: none; }
  .is-inview .vis-reg li:nth-child(1) :global(svg) { transition-delay: 0.4s; }
  .is-inview .vis-reg li:nth-child(2) :global(svg) { transition-delay: 0.7s; }
  .is-inview .vis-reg li:nth-child(3) :global(svg) { transition-delay: 1s; }
  .is-inview .vis-reg li:nth-child(4) :global(svg) { transition-delay: 1.3s; }

  .vis-time { display: flex; flex-direction: column; justify-content: center; padding: 18px 20px; }
  .vis-time__row { display: grid; grid-template-columns: 16px 1fr auto; gap: 12px; align-items: center; font-size: 0.9rem; font-weight: 700; }
  .vis-time__t { color: var(--ink-2); font-weight: 600; }
  .vis-time__dot { width: 16px; height: 16px; border-radius: 50%; border: 2px solid var(--ink); background: #fff; }
  .vis-time__dot--on { background: var(--peach); border-color: var(--ink); transform: scale(0.4); transition: transform 0.6s var(--ease-out) 1.4s; }
  .is-inview .vis-time__dot--on { transform: scale(1.3); }
  .vis-time__line { height: 70px; margin-left: 7px; width: 2px; background: var(--grey-2); position: relative; }
  .vis-time__line span { position: absolute; inset: 0; background: var(--ink); transform: scaleY(0); transform-origin: top; transition: transform 1s var(--ease-in-out) 0.4s; }
  .is-inview .vis-time__line span { transform: none; }

  .vis-effort { display: grid; grid-template-columns: 0.75fr 1.45fr; gap: 10px; padding: 14px; align-items: start; }
  .vis-effort__col { display: flex; flex-wrap: wrap; gap: 5px; align-content: flex-start; }
  .vis-effort__col--us { border-left: 2px dashed var(--grey-2); padding-left: 10px; }
  .vis-effort__who { width: 100%; font-size: 0.85rem; font-weight: 800; margin-bottom: 4px; }
  .chipx { display: inline-flex; align-items: center; gap: 5px; font-size: 0.78rem; font-weight: 650; padding: 5px 9px; border-radius: 999px; background: var(--grey); opacity: 0; transform: translateY(8px) scale(0.9); transition: all 0.45s var(--ease-out); transition-delay: calc(0.6s + var(--i, 0) * 0.08s); white-space: nowrap; }
  .chipx--you { background: var(--peach); transition-delay: 0.3s; }
  .is-inview .chipx { opacity: 1; transform: none; }
  html:not(.js) .chipx { opacity: 1; transform: none; }

  @media (max-width: 1180px) { .value__grid { grid-template-columns: 1fr 1fr; } .vcard { min-height: 480px; } }
  @media (max-width: 640px) { .value__grid { grid-template-columns: 1fr; } .vcard { min-height: 0; } .vcard .h3 { margin-top: 8px; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.vis-wall').forEach((el) => {
    const set = () => el.style.setProperty('--w', `${el.clientWidth}px`);
    set();
    new ResizeObserver(set).observe(el);
    const card = el.closest<HTMLElement>('.vcard')!;
    const label = el.querySelector<HTMLElement>('[data-wall-label]')!;
    new MutationObserver(() => { if (card.classList.contains('is-inview')) setTimeout(() => (label.textContent = 'Nachher'), 1600); }).observe(card, { attributes: true, attributeFilter: ['class'] });
    // Replay on hover
    card.addEventListener('pointerenter', () => {
      card.classList.remove('is-inview'); label.textContent = 'Vorher';
      requestAnimationFrame(() => requestAnimationFrame(() => card.classList.add('is-inview')));
    });
  });
  const now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Europe/Berlin' }));
  const days = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  const pad = (n: number) => String(n).padStart(2, '0');
  document.querySelectorAll('[data-now-time]').forEach((el) => (el.textContent = `${days[now.getDay()]} ${pad(now.getHours())}:${pad(now.getMinutes())}`));
  const d = now.getDay();
  const reply = d === 0 || d === 6 ? 'Mo' : now.getHours() < 15 ? `${days[d]} · heute` : d === 5 ? 'Mo' : days[d + 1];
  document.querySelectorAll('[data-reply-day]').forEach((el) => (el.textContent = `bis ${reply}`));
</script>
