---
const methods = [
  { id: 'unterdruck', name: 'Unterdruck', text: 'Die feuchte Luft wird aus der Dämmschicht abgesaugt und über einen Wasserabscheider geführt. Aus dem Aufbau gelangt nichts in den Raum.', bores: 'etwa alle 5 m²', dur: '3 bis 4 Wochen', fit: 'Verdacht auf Keime, Schimmel oder Schadstoffe im Aufbau; bewohnte Räume.' },
  { id: 'ueberdruck', name: 'Überdruck', text: 'Trockene, auf etwa 55 bis 60 °C erwärmte Luft wird in die Dämmschicht gedrückt und tritt an den Randfugen wieder aus.', bores: 'etwa eine je 25 m²', dur: '2 bis 3 Wochen', fit: 'Sauberer Aufbau ohne Schadstoffverdacht, wenig Eingriff in den Belag gewünscht.' },
  { id: 'schiebezug', name: 'Schiebe-Zug', text: 'Drücken und Saugen im selben Aufbau: An einer Stelle wird trockene Luft eingebracht, an einer anderen abgesaugt.', bores: 'weniger als beim reinen Saugverfahren', dur: '2 bis 3 Wochen, rund 30 % schneller', fit: 'Größere Flächen, wenn Zeit zählt und der Belag erhalten bleiben soll.' },
  { id: 'randfuge', name: 'Randfuge', text: 'Die Luft wird über die geöffnete Randfuge geführt, ohne den Belag anzubohren. Zerstörungsfrei, aber begrenzt wirksam.', bores: 'keine', dur: 'abhängig vom Schadensumfang', fit: 'Kleiner Schaden, günstiger Aufbau, hochwertiger Belag, der erhalten bleiben muss.' },
];
---
<section class="section methods on-dark" id="verfahren">
  <div class="wrap">
    <div class="methods__head">
      <p class="eyebrow" data-reveal>Verfahren</p>
      <h2 class="h2" data-split>Trocknen, ohne den Boden <em class="hl-white">aufzureißen.</em></h2>
      <p class="lead" data-reveal>Unter dem Estrich liegt die Dämmschicht. Läuft dort Wasser hinein, trocknet sie von allein praktisch nicht mehr. Der Raum wirkt trocken, während der Aufbau nass bleibt. Welches Verfahren passt, entscheidet die Messung.</p>
    </div>

    <div class="methods__grid" data-methods data-active="unterdruck">
      <div class="diagram" aria-hidden="true">
        <svg viewBox="0 0 640 360" class="diagram__svg">
          <defs>
            <pattern id="screed" width="8" height="8" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="0.8" fill="rgba(255,255,255,.18)" /><circle cx="6" cy="6" r="0.6" fill="rgba(255,255,255,.12)" /></pattern>
            <pattern id="insul" width="14" height="14" patternUnits="userSpaceOnUse"><path d="M0 7 Q3.5 2 7 7 T14 7" fill="none" stroke="rgba(255,255,255,.18)" stroke-width="1" /></pattern>
            <marker id="arr" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#febe98" /></marker>
            <marker id="arrB" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#8ea2ff" /></marker>
          </defs>
          <!-- walls -->
          <rect x="20" y="40" width="22" height="300" fill="rgba(255,255,255,.08)" />
          <rect x="598" y="40" width="22" height="300" fill="rgba(255,255,255,.08)" />
          <!-- layers -->
          <rect x="42" y="150" width="556" height="14" fill="#d9b48f" opacity=".9" />
          <rect x="42" y="164" width="556" height="64" fill="#5a5f7a" />
          <rect x="42" y="164" width="556" height="64" fill="url(#screed)" />
          <rect x="42" y="228" width="556" height="54" fill="#2d3170" />
          <rect x="42" y="228" width="556" height="54" fill="url(#insul)" />
          <rect class="diagram__water" x="42" y="248" width="556" height="34" fill="#183eeb" opacity=".75" />
          <rect x="20" y="282" width="600" height="58" fill="rgba(255,255,255,.1)" />
          <!-- edge gaps -->
          <rect x="42" y="150" width="6" height="132" fill="#00024f" />
          <rect x="592" y="150" width="6" height="132" fill="#00024f" />
          <!-- labels -->
          <g class="diagram__labels">
            <text x="56" y="146">Belag</text>
            <text x="56" y="200">Estrich</text>
            <text x="56" y="242">Dämmschicht</text>
            <text x="56" y="316">Rohdecke</text>
          </g>
          <!-- bores -->
          <g class="m m--unterdruck m--ueberdruck m--schiebezug">
            <rect x="214" y="150" width="12" height="100" fill="#00024f" />
            <rect x="414" y="150" width="12" height="100" fill="#00024f" class="m m--unterdruck m--schiebezug" />
          </g>
          <!-- device -->
          <g class="diagram__device">
            <rect x="268" y="70" width="104" height="70" rx="8" fill="#fff" />
            <rect x="282" y="86" width="40" height="6" rx="3" fill="#183eeb" />
            <circle cx="350" cy="105" r="16" fill="none" stroke="#00024f" stroke-width="2" />
            <circle cx="350" cy="105" r="4" fill="#00024f" class="diagram__fan" />
            <text x="282" y="128" class="diagram__devlabel">Trockner</text>
          </g>
          <!-- flows: unterdruck (suck up) -->
          <g class="m m--unterdruck flow">
            <path d="M120 262 C 170 262 200 262 220 250" marker-end="url(#arrB)" />
            <path d="M320 262 C 280 262 240 262 222 250" marker-end="url(#arrB)" />
            <path d="M520 262 C 470 262 440 262 422 250" marker-end="url(#arrB)" />
            <path d="M220 150 C 220 120 250 110 268 110" marker-end="url(#arrB)" />
            <path d="M420 150 C 420 120 390 110 372 110" marker-end="url(#arrB)" />
          </g>
          <!-- flows: ueberdruck (push in, exit edges) -->
          <g class="m m--ueberdruck flow flow--warm">
            <path d="M268 112 C 240 112 220 120 220 148" marker-end="url(#arr)" />
            <path d="M220 262 C 160 262 90 262 52 240" marker-end="url(#arr)" />
            <path d="M226 262 C 360 262 520 262 588 240" marker-end="url(#arr)" />
            <path d="M45 200 C 45 160 45 140 45 110" marker-end="url(#arr)" />
            <path d="M595 200 C 595 160 595 140 595 110" marker-end="url(#arr)" />
          </g>
          <!-- flows: schiebe-zug -->
          <g class="m m--schiebezug flow flow--warm">
            <path d="M268 112 C 240 112 220 120 220 148" marker-end="url(#arr)" />
            <path d="M226 262 C 300 262 360 262 412 262" marker-end="url(#arr)" />
          </g>
          <g class="m m--schiebezug flow">
            <path d="M420 150 C 420 120 390 110 372 110" marker-end="url(#arrB)" />
          </g>
          <!-- flows: randfuge -->
          <g class="m m--randfuge flow flow--warm">
            <path d="M268 100 C 120 100 60 110 46 146" marker-end="url(#arr)" />
            <path d="M48 262 C 200 262 420 262 590 262" marker-end="url(#arr)" />
            <path d="M595 146 C 595 110 520 100 372 100" marker-end="url(#arr)" />
          </g>
        </svg>
        <p class="mono diagram__cap">Schnitt durch den Bodenaufbau · Schema</p>
      </div>

      <div class="mtabs">
        <div class="mtabs__list" role="tablist" aria-label="Trocknungsverfahren">
          {methods.map((m, i) => (
            <button role="tab" class="mtab" id={`tab-${m.id}`} aria-controls={`panel-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-method={m.id}>
              <span class="mono tnum">{String(i + 1).padStart(2, '0')}</span>{m.name}
            </button>
          ))}
        </div>
        {methods.map((m, i) => (
          <div class="mpanel" role="tabpanel" id={`panel-${m.id}`} aria-labelledby={`tab-${m.id}`} hidden={i !== 0}>
            <p class="mpanel__text">{m.text}</p>
            <dl class="mpanel__spec">
              <div><dt class="mono">Bohrungen</dt><dd>{m.bores}</dd></div>
              <div><dt class="mono">Dauer</dt><dd>{m.dur}</dd></div>
              <div><dt class="mono">Passt, wenn</dt><dd>{m.fit}</dd></div>
            </dl>
          </div>
        ))}
        <p class="mtabs__note">Bohrabstände und Dauer sind branchenübliche Orientierungswerte, keine Zusage für Ihr Objekt. Welches Verfahren eingesetzt wird, ergibt sich aus Schadensbild und Messung vor Ort.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .methods { background: var(--navy); }
  .methods__head { display: grid; gap: 20px; max-width: 900px; margin-bottom: clamp(40px, 6vw, 72px); }
  .methods__grid { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(24px, 4vw, 64px); align-items: start; }
  .diagram { padding: clamp(16px, 2vw, 24px); border-radius: 20px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--line); }
  .diagram__svg { width: 100%; height: auto; }
  .diagram__labels text, .diagram__devlabel { font-family: var(--font-mono); font-size: 11px; fill: rgba(255, 255, 255, 0.75); }
  .diagram__devlabel { fill: #00024f; font-size: 10px; }
  .diagram__cap { margin-top: 12px; color: var(--muted); font-size: 0.7rem; }
  .diagram__water { transform-box: fill-box; transform-origin: bottom; animation: drain 9s var(--ease-in-out) infinite; }
  @keyframes drain { 0% { transform: scaleY(1); } 70%, 100% { transform: scaleY(0.12); } }
  .diagram__fan { transform-box: fill-box; transform-origin: center; }
  .m { opacity: 0; transition: opacity 0.5s var(--ease-out); }
  [data-active='unterdruck'] .m--unterdruck,
  [data-active='ueberdruck'] .m--ueberdruck,
  [data-active='schiebezug'] .m--schiebezug,
  [data-active='randfuge'] .m--randfuge { opacity: 1; }
  .flow path { fill: none; stroke: #8ea2ff; stroke-width: 2; stroke-dasharray: 6 8; animation: flow 1.2s linear infinite; }
  .flow--warm path { stroke: #febe98; }
  @keyframes flow { to { stroke-dashoffset: -28; } }

  .mtabs__list { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 24px; }
  .mtab { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); font-weight: 540; text-align: left; transition: all 0.3s; }
  .mtab .mono { color: var(--muted); }
  .mtab:hover { border-color: var(--line-strong); }
  .mtab[aria-selected='true'] { background: #fff; color: var(--navy); border-color: #fff; }
  .mtab[aria-selected='true'] .mono { color: var(--blue); }
  .mpanel { animation: stepIn 0.5s var(--ease-out); }
  @keyframes stepIn { from { opacity: 0; transform: translateY(8px); } }
  .mpanel__text { font-size: var(--step-1); line-height: 1.45; margin-bottom: 24px; }
  .mpanel__spec { display: grid; border-top: 1px solid var(--line); }
  .mpanel__spec div { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .mpanel__spec dt { color: var(--muted); font-size: 0.7rem; padding-top: 3px; }
  .mtabs__note { margin-top: 20px; font-size: 0.82rem; color: var(--muted); }
  @media (max-width: 960px) { .methods__grid { grid-template-columns: 1fr; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-methods]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`)!.hidden = !on;
      });
      root.dataset.active = t.dataset.method!;
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'ArrowRight' || k === 'ArrowLeft') {
          const n = tabs[(i + (k === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
          n.focus();
          select(n);
        }
      });
    });
  });
</script>
