---
import Icon from './Icon.astro';
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  before: { label: string; items: string[]; total?: string };
  after: { label: string; items: string[]; total?: string };
}
const { eyebrow, title, intro, before, after } = Astro.props;
---
<section class="section compare">
  <div class="wrap">
    <div class="compare__head">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h2 class="h2" data-split set:html={title} />
      {intro && <p class="lead" data-reveal>{intro}</p>}
    </div>
    <div class="compare__grid">
      <div class="compare__col compare__col--before" data-reveal>
        <p class="compare__label"><span class="compare__dot"></span>{before.label}</p>
        <ul>
          {before.items.map((it, i) => (
            <li style={`--i:${i}`}><Icon name="x" size={16} /><span>{it}</span></li>
          ))}
        </ul>
        {before.total && <p class="compare__total compare__total--strike">{before.total}</p>}
      </div>
      <div class="compare__col compare__col--after" data-reveal style="--d:.12s" data-inview>
        <p class="compare__label"><span class="compare__dot compare__dot--on"></span>{after.label}</p>
        <ul>
          {after.items.map((it, i) => (
            <li style={`--i:${i}`}><Icon name="check" size={16} /><span>{it}</span></li>
          ))}
        </ul>
        {after.total && <p class="compare__total">{after.total}</p>}
        <div class="compare__glow" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .compare__head { display: grid; gap: 20px; max-width: 1000px; margin-bottom: clamp(40px, 5vw, 72px); }
  .compare__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .compare__col { position: relative; border-radius: 24px; padding: clamp(24px, 3.5vw, 48px); min-height: 440px; display: flex; flex-direction: column; }
  .compare__col--before { background: var(--grey); color: var(--ink-2); }
  .compare__col--after { background: var(--hl); color: var(--hl-ink); --line: rgba(0, 0, 0, 0.14); }
  .world-water .compare__col--after { --line: rgba(255, 255, 255, 0.25); }
  .compare__label { display: inline-flex; align-items: center; gap: 10px; font-size: 0.95rem; font-weight: 700; margin-bottom: 28px; }
  .compare__dot { display: none; }
  .compare ul { display: grid; }
  .compare li { display: flex; gap: 14px; align-items: flex-start; padding: 16px 0; border-top: 2px solid var(--line); font-size: var(--step-1); font-weight: 600; line-height: 1.3; letter-spacing: -0.015em; }
  .compare__col--before li { border-color: #dededa; }
  .compare__col--before li span { text-decoration: line-through; text-decoration-color: rgba(0, 0, 0, 0.35); text-decoration-thickness: 2px; }
  .compare li :global(svg) { margin-top: 3px; flex: none; width: 22px; height: 22px; stroke-width: 2.4; }
  .compare__col--after li :global(svg) { background: var(--hl-ink); color: var(--hl); border-radius: 50%; padding: 3px; }
  .compare__col--after li { opacity: 0; transform: translateY(10px); transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out); transition-delay: calc(0.2s + var(--i) * 0.08s); }
  .compare__col--after.is-inview li { opacity: 1; transform: none; }
  html:not(.js) .compare__col--after li { opacity: 1; transform: none; }
  .compare__total { margin-top: auto; padding-top: 36px; font-weight: 800; letter-spacing: -0.05em; font-size: var(--step-4); line-height: 0.95; }
  .compare__total--strike { color: #b9b9b4; text-decoration: line-through; text-decoration-thickness: 4px; }
  .compare__glow { display: none; }
  @media (max-width: 860px) { .compare__grid { grid-template-columns: 1fr; } .compare__col { min-height: 0; } }
</style>
