---
import Img from './Img.astro';
import Funnel from './Funnel.astro';
import Icon from './Icon.astro';
interface Props {
  image: string;
  imageAlt: string;
  position?: string;
  eyebrow: string;
  title: string;
  lead: string;
  flow: 'start' | 'wasser' | 'maler';
  proof: string[];
}
const { image, imageAlt, position, eyebrow, title, lead, flow, proof } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow" data-reveal>{eyebrow}</p>
        <h1 class="h1 hero__title" data-split="now" set:html={title} />
        <p class="lead hero__lead" data-reveal style="--d:.15s">{lead}</p>
        <slot name="actions" />
        <ul class="hero__proof" data-reveal style="--d:.25s">
          {proof.map((p) => <li><Icon name="check" size={16} />{p}</li>)}
        </ul>
      </div>
      <div class="hero__form" data-reveal style="--d:.2s">
        <Funnel flow={flow} tiles={flow === 'start'} />
      </div>
    </div>
  </div>
  <div class="wrap">
    <div class="hero__media media media--parallax" data-parallax="8" data-reveal="fade">
      <Img name={image} alt={imageAlt} eager sizes="100vw" position={position} />
    </div>
  </div>
</section>

<style>
  .hero { padding: calc(var(--nav-h) + clamp(32px, 4vw, 56px)) 0 0; }
  .hero__eyebrow { font-weight: 650; font-size: 0.95rem; margin-bottom: -6px; }
  .hero__title { font-size: clamp(3rem, 1.4rem + 4.6vw, 6.4rem); }
  .hero__grid { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: clamp(32px, 5vw, 88px); align-items: start; }
  .hero__copy { display: grid; gap: 28px; }
  .hero__lead { color: var(--ink); max-width: 34ch; font-size: var(--step-1); line-height: 1.4; letter-spacing: -0.015em; font-weight: 500; }
  .hero__proof { display: grid; grid-template-columns: repeat(2, max-content); gap: 10px 28px; font-weight: 600; }
  @media (max-width: 560px) { .hero__proof { grid-template-columns: 1fr; } }
  .hero__proof li { display: flex; align-items: center; gap: 10px; }
  .hero__proof :global(svg) { flex: none; width: 22px; height: 22px; padding: 3px; border-radius: 50%; background: var(--hl); color: var(--hl-ink); stroke-width: 2.4; }
  .hero__form { display: flex; justify-content: flex-end; }
  .hero__media { margin-top: clamp(48px, 6vw, 96px); aspect-ratio: 21 / 9; }
  @media (max-width: 1000px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__form { justify-content: stretch; }
    .hero__form :global(.funnel) { max-width: none; }
    .hero__media { aspect-ratio: 4 / 3; }
  }
</style>
