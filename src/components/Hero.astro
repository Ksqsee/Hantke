---
import Img from './Img.astro';
import Funnel from './Funnel.astro';
interface Props {
  image: string;
  imageAlt: string;
  position?: string;
  title: string;
  lead: string;
  flow: 'start' | 'wasser' | 'maler';
  proof: string;
}
const { image, imageAlt, position, title, lead, flow, proof } = Astro.props;
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 class="h1 hero__title" data-split="now" set:html={title} />
      <p class="hero__lead" data-reveal style="--d:.15s">{lead}</p>
      <slot name="actions" />
      <p class="hero__proof" data-reveal style="--d:.25s"><span class="hero__stars" aria-hidden="true">★★★★★</span> {proof}</p>
    </div>
    <div class="hero__form" data-reveal style="--d:.2s">
      <Funnel flow={flow} tiles={flow === 'start'} />
    </div>
  </div>
  <div class="wrap">
    <div class="hero__media media media--parallax" data-parallax="8" data-reveal="fade">
      <Img name={image} alt={imageAlt} eager sizes="100vw" position={position} />
    </div>
  </div>
</section>

<style>
  .hero { padding: calc(var(--nav-h) + clamp(40px, 5vw, 80px)) 0 0; }
  .hero__grid { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: clamp(32px, 5vw, 88px); align-items: center; }
  .hero__copy { display: grid; gap: 28px; }
  .hero__title { font-size: clamp(3rem, 1.4rem + 4.8vw, 6.8rem); }
  .hero__lead { font-size: var(--step-2); line-height: 1.25; letter-spacing: -0.025em; font-weight: 550; max-width: 22ch; }
  .hero__proof { font-weight: 650; font-size: 0.98rem; }
  .hero__stars { letter-spacing: 2px; margin-right: 6px; }
  .hero__form { display: flex; justify-content: flex-end; }
  .hero__media { margin-top: clamp(48px, 6vw, 96px); aspect-ratio: 21 / 8; }
  @media (max-width: 1000px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__form { justify-content: stretch; }
    .hero__form :global(.funnel) { max-width: none; }
    .hero__media { aspect-ratio: 4 / 3; }
  }
</style>
