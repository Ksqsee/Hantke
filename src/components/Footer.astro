---
import { company, phones } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer on-dark">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__claim h2">Renovieren.<br />Gestalten.<br /><em>Erhalten.</em></p>
      <div class="footer__lines">
        <a href={phones.maler.href} class="footer__line">
          <span class="mono">Malerarbeiten</span>
          <span class="footer__num tnum">{phones.maler.display}</span>
        </a>
        <a href={phones.wasser.href} class="footer__line footer__line--water">
          <span class="mono">Wasserschaden</span>
          <span class="footer__num tnum">{phones.wasser.display}</span>
        </a>
        <a href={`mailto:${company.email}`} class="footer__line">
          <span class="mono">E-Mail</span>
          <span class="footer__num">{company.email}</span>
        </a>
      </div>
    </div>

    <div class="footer__grid">
      <div>
        <img src="/brand/maler-hantke.svg" alt="Maler Hantke" width="150" height="34" class="footer__logo" />
        <p class="footer__small">{company.name} — {company.claim}.<br />Meisterbetrieb seit {company.founded}.</p>
      </div>
      <div>
        <p class="mono footer__label">Betrieb</p>
        <p>{company.street}<br />{company.zip} {company.city}-{company.district}</p>
      </div>
      <div>
        <p class="mono footer__label">Seiten</p>
        <ul>
          <li><a href="/malerarbeiten">Malerarbeiten</a></li>
          <li><a href="/wasserschaden">Wasserschaden &amp; Trocknung</a></li>
          <li><a href="/ueber-uns">Über uns</a></li>
          <li><a href="/karriere">Karriere</a></li>
        </ul>
      </div>
      <div>
        <p class="mono footer__label">Nachprüfbar</p>
        <p>{company.hrb}, {company.court}<br />HWK Hamburg Nr. {company.hwkNumber}</p>
      </div>
    </div>

    <div class="footer__base">
      <span>© {year} {company.name}</span>
      <nav aria-label="Rechtliches">
        <a href="/impressum">Impressum</a>
        <a href="/datenschutz">Datenschutz</a>
        <a href="/bildnachweise">Bildnachweise</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--ink); padding: clamp(72px, 10vw, 140px) 0 calc(28px + env(safe-area-inset-bottom)); }
  .footer__top { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: end; padding-bottom: clamp(56px, 8vw, 110px); border-bottom: 1px solid var(--line); }
  .footer__claim { --hl: var(--peach); --hl-ink: var(--ink); }
  .footer__lines { display: grid; }
  .footer__line { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 18px 0; border-top: 1px solid var(--line); transition: padding 0.5s var(--ease-out), color 0.3s; }
  .footer__line:last-child { border-bottom: 1px solid var(--line); }
  .footer__line .mono { color: var(--muted); font-size: 0.9rem; }
  .footer__num { font-size: var(--step-2); font-weight: 750; letter-spacing: -0.03em; }
  .footer__line:hover { padding-left: 12px; color: var(--peach); }
  .footer__line--water:hover { color: #8ea2ff; }
  .footer__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 32px; padding: 56px 0; color: var(--muted); font-size: 0.95rem; }
  .footer__grid a:hover { color: var(--fg); }
  .footer__grid li + li { margin-top: 6px; }
  .footer__logo { filter: brightness(0) invert(1); height: 30px; width: auto; margin-bottom: 18px; }
  .footer__label { color: var(--fg); margin-bottom: 12px; font-size: 0.92rem; }
  .footer__small { max-width: 32ch; }
  .footer__base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line); font-size: 0.85rem; color: var(--muted); }
  .footer__base nav { display: flex; gap: 20px; }
  .footer__base a:hover { color: var(--fg); }
  @media (max-width: 900px) {
    .footer__top { grid-template-columns: 1fr; }
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .footer__grid { grid-template-columns: 1fr; } }
</style>
