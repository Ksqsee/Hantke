---
interface Props { eyebrow?: string; title: string; items: { title: string; text: string }[] }
const { eyebrow = 'Unsere Zusagen', title, items } = Astro.props;
---
<section class="section promises on-dark">
  <div class="wrap">
    <div class="promises__head">
      <p class="eyebrow" data-reveal>{eyebrow}</p>
      <h2 class="h2" data-split set:html={title} />
    </div>
    <ol class="promises__grid">
      {items.map((it, i) => (
        <li class="promise" data-reveal style={`--d:${i * 0.08}s`}>
          <span class="promise__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3">{it.title}</h3>
          <p class="body">{it.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .promises { background: var(--blue); --hl: var(--peach); --hl-ink: var(--ink); }
  .world-water .promises { background: var(--navy); }
  .promises__head { display: grid; gap: 20px; max-width: 960px; margin-bottom: clamp(48px, 6vw, 88px); }
  .promises .eyebrow { color: #fff; }
  .promises__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .promise { position: relative; padding: 26px; border-radius: 22px; background: #fff; color: var(--ink); display: grid; gap: 14px; align-content: start; min-height: 360px; --muted: var(--ink-2); transition: transform 0.4s var(--ease-out); }
  .promise:nth-child(odd):hover { transform: rotate(-1deg) translateY(-4px); }
  .promise:nth-child(even):hover { transform: rotate(1deg) translateY(-4px); }
  .promise__num { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: var(--peach); font-weight: 800; font-size: 1.2rem; letter-spacing: -0.03em; }
  .promise .h3 { margin-top: 40px; }
  .promise .body { color: var(--ink-2); }
  @media (max-width: 1100px) { .promises__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .promises__grid { grid-template-columns: 1fr; } .promise { min-height: 0; } }
</style>
