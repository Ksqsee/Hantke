---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { company, phones } from '../data/site';
---
<Base title="Über uns | Maler Hantke, Hamburg-Lokstedt" description="Tomas Hantke Malermeister GmbH, Bötelkamp 31 in Hamburg-Lokstedt. Meisterbetrieb seit 2002. Ein fester Ansprechpartner vom Angebot bis zur Abnahme.">
  <PageHead eyebrow="Über uns" title="Ein Betrieb. <em>Seit 2002.</em>" lead="Wir planen, führen aus und nehmen ab. Immer dieselben Leute, kein Vermittlungsportal." />

  <section class="wrap">
    <div class="about-media media media--parallax" data-parallax="8" data-reveal="fade">
      <Img name="lokstedt-backstein" alt="Backsteinhaus in Hamburg-Lokstedt" sizes="100vw" />
    </div>
  </section>

  <section class="section">
    <div class="wrap proof-grid">
      <div class="ptile ptile--peach" data-reveal>
        <p class="ptile__v">2002</p>
        <p class="ptile__t">Im Handelsregister, {company.hrb}</p>
      </div>
      <div class="ptile ptile--ink" data-reveal style="--d:.06s">
        <p class="ptile__v">Meister</p>
        <p class="ptile__t">Handwerkskammer Hamburg, Nr. {company.hwkNumber}</p>
      </div>
      <div class="ptile ptile--blue" data-reveal style="--d:.12s">
        <p class="ptile__v">Lokstedt</p>
        <p class="ptile__t">Eigene Werkstatt, {company.street}</p>
      </div>
    </div>
  </section>

  <section class="section surface-grey">
    <div class="wrap person">
      <div class="person__card" data-reveal>
        <div class="person__avatar" aria-hidden="true">FQ</div>
        <p class="person__name">{company.manager}</p>
        <p class="person__role">Betriebsleiter</p>
        <a href={phones.maler.href} class="btn"><Icon name="phone" class="btn__icon" /> {phones.maler.display}</a>
      </div>
      <div class="person__copy">
        <h2 class="h2" data-split>Ihr <em>Ansprechpartner.</em></h2>
        <p class="lead" data-reveal>Vom Aufmaß bis zur Abnahme. Kein Callcenter, kein wechselnder Bearbeiter.</p>
      </div>
    </div>
  </section>

  <CtaFinal flow="start" title="Was steht <em>an?</em>" text="Vier Klicks, Ihre Nummer. Wir rufen zurück." />
</Base>

<style>
  .about-media { aspect-ratio: 21 / 8; }
  .proof-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .ptile { padding: 28px; border-radius: 26px; display: grid; gap: 10px; min-height: 260px; align-content: space-between; }
  .ptile--peach { background: var(--peach); }
  .ptile--ink { background: var(--ink); color: #fff; }
  .ptile--blue { background: var(--blue); color: #fff; }
  .ptile__v { font-weight: 800; font-size: clamp(2.8rem, 5.4vw, 5.2rem); letter-spacing: -0.06em; line-height: 0.9; }
  .ptile__t { font-weight: 600; opacity: 0.85; }
  .person { display: grid; grid-template-columns: 4fr 7fr; gap: clamp(32px, 6vw, 110px); align-items: center; }
  .person__card { padding: 28px; border-radius: 28px; background: #fff; display: grid; gap: 4px; justify-items: start; }
  .person__avatar { width: 88px; height: 88px; border-radius: 50%; background: var(--peach); display: grid; place-items: center; font-weight: 800; font-size: 1.8rem; letter-spacing: -0.04em; margin-bottom: 16px; }
  .person__name { font-size: var(--step-3); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .person__role { font-weight: 650; color: var(--ink-2); margin-bottom: 20px; }
  .person__copy { display: grid; gap: 20px; }
  @media (max-width: 900px) {
    .proof-grid, .person { grid-template-columns: 1fr; }
    .ptile { min-height: 180px; }
    .about-media { aspect-ratio: 4 / 3; }
  }
</style>
