---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import CompareTable from '../components/CompareTable.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { malerSteps, compareRows, generalFaq } from '../data/content';
---
<Base
  title="Maler Hantke Hamburg | Malermeister & Bautrocknung seit 2002"
  description="Malerarbeiten und Trocknung nach Wasserschaden aus einer Hand. Meisterbetrieb aus Hamburg-Lokstedt, 5,0 auf Google. Rückmeldung am selben Werktag."
>
  <Hero
    image="eppendorf-altbau"
    imageAlt="Altbau mit Erkern in Hamburg-Eppendorf"
    position="50% 35%"
    title="Ein Anruf.<br />Ein <em>fertiger</em> Raum."
    lead="Malermeister aus Hamburg. Wir trocknen, spachteln und streichen. Alles selbst."
    flow="start"
    proof="5,0 auf Google · Meister seit 2002"
  />

  <Steps title="So einfach <em>geht's.</em>" steps={malerSteps} />

  <CompareTable title="Eine Firma statt <em>drei.</em>" us="Hantke" them="Üblich" rows={compareRows} />

  <section class="section">
    <div class="wrap worlds">
      <article class="world world--warm" data-reveal>
        <div class="world__media media"><Img name="villa-mittelweg" alt="Gründerzeitvilla am Mittelweg in Hamburg" sizes="(max-width: 900px) 100vw, 50vw" /></div>
        <h2 class="h2">Malerarbeiten</h2>
        <p class="world__text">Wände, Decken, Tapeten, Fassade, Lack. Von einfach bis edel.</p>
        <a href="/malerarbeiten" class="world__go">Ansehen <Icon name="arrow" size={18} /></a>
      </article>
      <article class="world world--water" data-reveal style="--d:.08s">
        <div class="world__media media"><Img name="regenfront" alt="Regenfront über Hamburg" sizes="(max-width: 900px) 100vw, 50vw" position="60% 50%" /></div>
        <h2 class="h2">Wasserschaden</h2>
        <p class="world__text">Messen, trocknen, herrichten. Mit Protokoll für die Versicherung.</p>
        <a href="/wasserschaden" class="world__go">Ansehen <Icon name="arrow" size={18} /></a>
      </article>
    </div>
  </section>

  <Reviews />

  <Faq title="Kurz <em>gefragt.</em>" items={generalFaq} />

  <CtaFinal flow="start" title="Was steht <em>an?</em>" text="Vier Klicks, Ihre Nummer. Wir rufen zurück." />
</Base>

<style>
  .worlds { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .world { position: relative; display: grid; gap: 14px; align-content: start; border-radius: 28px; padding: 12px 12px clamp(24px, 3vw, 36px); transition: transform 0.4s var(--ease-out); }
  .world:hover { transform: translateY(-4px); }
  .world--warm { background: var(--peach); }
  .world--water { background: var(--blue); color: #fff; }
  .world__media { aspect-ratio: 16 / 10; border-radius: 18px; margin-bottom: 12px; }
  .world .h2, .world__text, .world__go { margin-inline: clamp(8px, 2vw, 24px); }
  .world__text { font-size: var(--step-1); font-weight: 550; max-width: 30ch; }
  .world__go { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; width: fit-content; padding: 12px 20px; border-radius: 999px; background: var(--ink); color: #fff; margin-top: 6px; }
  .world--water .world__go { background: #fff; color: var(--blue); }
  .world__go::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .world :global(.credit) { z-index: 2; }
  @media (max-width: 900px) { .worlds { grid-template-columns: 1fr; } }
</style>
