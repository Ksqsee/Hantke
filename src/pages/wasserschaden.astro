---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Checklist from '../components/Checklist.astro';
import Steps from '../components/Steps.astro';
import MoistureChart from '../components/MoistureChart.astro';
import CompareTable from '../components/CompareTable.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { phones } from '../data/site';
import { wasserSteps, wasserFaq } from '../data/content';
---
<Base
  title="Wasserschaden Hamburg | Hantke Bautrocknung"
  description="Wasserschaden in Hamburg? Wir messen, trocknen und richten die Wand selbst wieder her. Mit Messprotokoll für die Versicherung. Anrufen: 0178 357 00 38."
  world="water"
>
  <Hero
    image="regenfront"
    imageAlt="Dunkle Regenfront über den Dächern von Hamburg"
    position="65% 50%"
    title="Wasser&shy;schaden? <em>Wir kommen.</em>"
    lead="Erst Haupthahn zu. Dann anrufen. Wir messen, trocknen und richten alles wieder her."
    flow="wasser"
    proof="5,0 auf Google · Meister seit 2002"
  >
    <div slot="actions" data-reveal style="--d:.2s">
      <a href={phones.wasser.href} class="btn btn--blue btn--lg"><Icon name="phone" class="btn__icon" /> <span class="tnum">{phones.wasser.display}</span></a>
    </div>
  </Hero>

  <Checklist />

  <Steps title="Messen. Trocknen. <em>Fertig.</em>" steps={wasserSteps} />

  <section class="section measure">
    <div class="wrap measure__grid">
      <div class="measure__copy">
        <h2 class="h2" data-split>Gemessen, nicht <em>geschätzt.</em></h2>
        <p class="lead" data-reveal>Abgebaut wird erst, wenn der Messwert stimmt. Jeder Wert steht im Protokoll für Ihre Versicherung.</p>
      </div>
      <div data-reveal><MoistureChart /></div>
    </div>
  </section>

  <CompareTable title="Trocknen <em>und</em> herrichten." us="Hantke" them="Nur Trocknung" rows={['Messen und trocknen', 'Spachteln und streichen danach', 'Ein Ansprechpartner', 'Protokoll und Rechnung nach Positionen', 'Leckortung ohne Fremdfirma']} />

  <Reviews />

  <Faq title="Kurz <em>gefragt.</em>" items={wasserFaq} />

  <CtaFinal flow="wasser" title="Nass ist ein <em>Zeitproblem.</em>" text="Nummer und was passiert ist. Wir rufen zurück." />
</Base>

<style>
  .measure__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .measure__copy { display: grid; gap: 22px; }
  @media (max-width: 960px) { .measure__grid { grid-template-columns: 1fr; } }
</style>
