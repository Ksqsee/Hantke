---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Steps from '../components/Steps.astro';
import CompareTable from '../components/CompareTable.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Icon from '../components/Icon.astro';
import { phones } from '../data/site';
import { malerSteps, compareRows, malerFaq } from '../data/content';

const services = ['Wände und Decken', 'Tapezieren', 'Spachteln und Glätten', 'Strukturputz', 'Fassade', 'Fenster und Türen lackieren', 'Boden verlegen', 'Plissees und Sonnenschutz', 'Küchenmontage'];
---
<Base
  title="Malerarbeiten Hamburg | Maler Hantke, Meisterbetrieb seit 2002"
  description="Malerarbeiten in Hamburg vom Meisterbetrieb: Wände, Decken, Tapeten, Fassade, Lack. Angebot kostenlos, Rückmeldung am selben Werktag."
>
  <Hero
    image="harvestehude-villa"
    imageAlt="Helle Villa in Hamburg-Harvestehude"
    position="50% 55%"
    title="Sauber <em>gestrichen.</em>"
    lead="Wände, Decken, Fassade. Festes Angebot vorher, kostenlos."
    flow="maler"
    proof="5,0 auf Google · Meister seit 2002"
  >
    <div slot="actions" data-reveal style="--d:.2s">
      <a href={phones.maler.href} class="btn btn--lg"><Icon name="phone" class="btn__icon" /> <span class="tnum">{phones.maler.display}</span></a>
    </div>
  </Hero>

  <section class="section">
    <div class="wrap">
      <h2 class="h2 srv__title" data-split>Was wir <em>machen.</em></h2>
      <ul class="srows">
        {services.map((s, i) => (
          <li data-reveal style={`--d:${i * 0.03}s`}>
            <a href="#anfrage" class="srow"><span class="srow__name">{s}</span><span class="srow__go"><Icon name="arrow" size={20} /></span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Steps title="So einfach <em>geht's.</em>" steps={malerSteps} />

  <CompareTable title="Eine Firma statt <em>drei.</em>" us="Hantke" them="Üblich" rows={compareRows} />

  <Reviews />

  <Faq title="Kurz <em>gefragt.</em>" items={malerFaq} />

  <CtaFinal flow="maler" title="Was steht <em>an?</em>" text="Ein paar Klicks, Ihre Nummer, gern ein Foto. Wir melden uns am selben Werktag." />
</Base>

<style>
  .srv__title { margin-bottom: clamp(32px, 4vw, 56px); }
  .srows { border-top: 2px solid var(--ink); }
  .srow { position: relative; isolation: isolate; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 12px; border-bottom: 2px solid var(--ink); transition: padding 0.35s var(--ease-out); }
  .srow::before { content: ''; position: absolute; inset: 0; background: var(--peach); transform: scaleY(0); transform-origin: bottom; transition: transform 0.4s var(--ease-out); z-index: -1; }
  .srow:hover::before { transform: scaleY(1); }
  .srow:hover { padding-left: 24px; }
  .srow__name { font-size: var(--step-3); font-weight: 800; letter-spacing: -0.045em; line-height: 1.05; }
  .srow__go { flex: none; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--grey); transition: background 0.3s; }
  .srow:hover .srow__go { background: var(--ink); color: #fff; }
  @media (max-width: 600px) { .srow__go { width: 40px; height: 40px; } }
</style>
