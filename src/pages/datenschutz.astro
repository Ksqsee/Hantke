---
import Base from '../layouts/Base.astro';
import Legal from '../components/Legal.astro';
import { company } from '../data/site';
// Based on the current Datenschutzerklärung of maler-hantke.de, adapted to this build:
// self-hosted fonts, no cookies, no analytics. Hosting and form provider must be filled in
// once decided (marked with <mark>).
const sections = [
  { h: 'Verantwortliche Stelle', p: [`Verantwortlich für die Datenverarbeitung auf dieser Website ist:<br />${company.name} — ${company.claim}<br />${company.street}, ${company.zip} ${company.city}<br />Telefon: +49 40 879 31 31<br />E-Mail: <a href="mailto:${company.email}">${company.email}</a>`, 'Verantwortliche Stelle ist die natürliche oder juristische Person, die allein oder gemeinsam mit anderen über die Zwecke und Mittel der Verarbeitung von personenbezogenen Daten entscheidet.'] },
  { h: 'Allgemeine Hinweise', p: ['Personenbezogene Daten sind alle Daten, mit denen Sie persönlich identifiziert werden können. Diese Erklärung beschreibt, welche Daten wir beim Besuch dieser Website erheben, wozu wir sie nutzen und welche Rechte Ihnen zustehen.', 'Wir behandeln Ihre personenbezogenen Daten vertraulich und entsprechend den gesetzlichen Datenschutzvorschriften sowie dieser Datenschutzerklärung.'] },
  { h: 'Rechtsgrundlagen der Verarbeitung', p: ['Wir verarbeiten personenbezogene Daten auf Grundlage Ihrer Einwilligung (Art. 6 Abs. 1 lit. a DSGVO), zur Erfüllung eines Vertrags oder zur Durchführung vorvertraglicher Maßnahmen (Art. 6 Abs. 1 lit. b DSGVO), zur Erfüllung rechtlicher Verpflichtungen (Art. 6 Abs. 1 lit. c DSGVO) oder auf Grundlage unseres berechtigten Interesses an einem sicheren und funktionsfähigen Webauftritt (Art. 6 Abs. 1 lit. f DSGVO).'] },
  { h: 'Hosting und technische Bereitstellung', p: ['Diese Website wird bei <mark>[Hosting-Anbieter, Anschrift]</mark> betrieben. Der Anbieter verarbeitet die beim Aufruf der Seite anfallenden technischen Zugriffsdaten als Auftragsverarbeiter für uns. Grundlage ist ein Auftragsverarbeitungsvertrag nach Art. 28 DSGVO.', 'Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO, unser berechtigtes Interesse an einem sicheren und zuverlässig erreichbaren Webauftritt.'] },
  { h: 'Server-Logfiles', p: ['Beim Aufruf dieser Website werden automatisch Informationen in Server-Logfiles gespeichert, die Ihr Browser übermittelt: Browsertyp und Browserversion, verwendetes Betriebssystem, Referrer-URL, Hostname des zugreifenden Rechners, Uhrzeit der Serveranfrage und IP-Adresse.', 'Eine Zusammenführung dieser Daten mit anderen Datenquellen findet nicht statt. Die Erfassung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO zur technisch fehlerfreien Darstellung und zur Absicherung der Website.'] },
  { h: 'Cookies und Analyse', p: ['Diese Website setzt keine Cookies und bindet keine Analyse- oder Marketingdienste ein. Sobald wir einwilligungspflichtige Dienste einsetzen, ergänzen wir diese Erklärung und laden die Dienste erst nach Ihrer Zustimmung.'] },
  { h: 'Anfrageformulare', p: ['Auf dieser Website stehen Formulare bereit, über die Sie uns eine Anfrage senden können. Die dort eingegebenen Daten, insbesondere Anliegen, Umfang, Zeitraum, Name, Telefonnummer, E-Mail-Adresse, Postleitzahl oder Objektadresse und Ihre Nachricht, speichern wir zur Bearbeitung der Anfrage und für den Fall von Anschlussfragen.', 'Sie können den Formularen optional Fotos oder PDF-Dateien beifügen. Diese Dateien dienen ausschließlich der Einschätzung Ihres Anliegens. Bitte laden Sie keine Dateien hoch, die personenbezogene Daten Dritter enthalten.', 'Die Formulardaten werden über <mark>[Formular-Dienstleister]</mark> an uns übermittelt. Ist kein Formulardienst eingerichtet, öffnet das Formular Ihr E-Mail-Programm mit den eingegebenen Angaben; die Übermittlung erfolgt dann per E-Mail.', 'Rechtsgrundlage ist Art. 6 Abs. 1 lit. b DSGVO, sofern Ihre Anfrage mit der Anbahnung eines Vertrags zusammenhängt, im Übrigen Ihre Einwilligung nach Art. 6 Abs. 1 lit. a DSGVO sowie unser berechtigtes Interesse an der Beantwortung von Anfragen nach Art. 6 Abs. 1 lit. f DSGVO. Die Daten verbleiben bei uns, bis Sie uns zur Löschung auffordern, Ihre Einwilligung widerrufen oder der Zweck entfällt. Zwingende gesetzliche Aufbewahrungsfristen bleiben unberührt.'] },
  { h: 'Anfrage per Telefon oder E-Mail', p: ['Wenn Sie uns telefonisch oder per E-Mail kontaktieren, speichern und verarbeiten wir Ihre Anfrage samt aller daraus hervorgehenden personenbezogenen Daten zum Zweck der Bearbeitung. Diese Daten geben wir nicht ohne Ihre Einwilligung weiter. Es gelten dieselben Rechtsgrundlagen und Löschfristen wie bei den Anfrageformularen.'] },
  { h: 'Bewerbungen und Bewerberdaten', p: ['Über das Bewerbungsformular auf unserer Karriereseite können Sie sich bei uns bewerben. Wir verarbeiten die dabei übermittelten Daten, also Name, Telefonnummer, E-Mail-Adresse, gewünschte Stelle, Ihre Nachricht sowie hochgeladene Unterlagen, ausschließlich zur Durchführung des Bewerbungsverfahrens.', 'Rechtsgrundlage ist § 26 Abs. 1 Satz 1 BDSG in Verbindung mit Art. 88 DSGVO. Ergänzend stützen wir uns auf Art. 6 Abs. 1 lit. b DSGVO für vorvertragliche Maßnahmen und, soweit Sie Angaben freiwillig machen, auf Ihre Einwilligung nach Art. 6 Abs. 1 lit. a DSGVO.', 'Kommt es nicht zu einer Einstellung, löschen wir Ihre Bewerbungsunterlagen spätestens sechs Monate nach Abschluss des Bewerbungsverfahrens. In unseren Bewerberpool nehmen wir Sie nur auf, wenn Sie ausdrücklich einwilligen; die Speicherung ist dann auf zwölf Monate begrenzt. Kommt ein Beschäftigungsverhältnis zustande, überführen wir Ihre Daten in die Personalakte.'] },
  { h: 'Schriftarten', p: ['Die auf dieser Website verwendete Schrift (Hanken Grotesk) wird lokal von unserem Server ausgeliefert. Es wird dabei keine Verbindung zu Servern Dritter aufgebaut.'] },
  { h: 'Speicherdauer', p: ['Soweit in dieser Erklärung keine speziellere Speicherdauer genannt ist, verbleiben Ihre personenbezogenen Daten bei uns, bis der Zweck für die Datenverarbeitung entfällt. Wenn Sie ein berechtigtes Löschersuchen geltend machen oder eine Einwilligung widerrufen, werden Ihre Daten gelöscht, sofern keine gesetzlich zulässigen Gründe für die Aufbewahrung bestehen.'] },
  { h: 'Ihre Rechte', p: ['Sie haben jederzeit das Recht auf unentgeltliche Auskunft über Ihre gespeicherten personenbezogenen Daten, deren Herkunft und Empfänger sowie den Zweck der Verarbeitung, und ein Recht auf Berichtigung oder Löschung dieser Daten.', 'Sie haben das Recht, die Einschränkung der Verarbeitung zu verlangen, sowie das Recht auf Datenübertragbarkeit. Eine erteilte Einwilligung können Sie jederzeit mit Wirkung für die Zukunft widerrufen. Sie haben das Recht, der Verarbeitung Ihrer Daten zu widersprechen, wenn die Verarbeitung auf Art. 6 Abs. 1 lit. e oder lit. f DSGVO beruht.'] },
  { h: 'Beschwerderecht bei der Aufsichtsbehörde', p: ['Ihnen steht ein Beschwerderecht bei einer Datenschutz-Aufsichtsbehörde zu. Für uns zuständig ist: Der Hamburgische Beauftragte für Datenschutz und Informationsfreiheit, Ludwig-Erhard-Straße 22, 20459 Hamburg, <a href="https://datenschutz-hamburg.de" rel="noopener">datenschutz-hamburg.de</a>.'] },
  { h: 'SSL- und TLS-Verschlüsselung', p: ['Diese Seite nutzt aus Sicherheitsgründen eine SSL- beziehungsweise TLS-Verschlüsselung. Bei aktivierter Verschlüsselung können die Daten, die Sie an uns übermitteln, nicht von Dritten mitgelesen werden.'] },
  { h: 'Änderungen dieser Erklärung', p: ['Wir passen diese Datenschutzerklärung an, sobald sich die auf dieser Website eingesetzten Dienste ändern. Es gilt jeweils die auf dieser Seite abrufbare Fassung.'] },
];
---
<Base title="Datenschutz — Maler Hantke Hamburg" description="Datenschutzerklärung der Tomas Hantke Malermeister GmbH." noindex>
  <Legal title="Datenschutz" intro="Welche Daten wir beim Besuch dieser Website verarbeiten, wozu wir sie nutzen und welche Rechte Sie haben." stand="Oktober 2026" sections={sections} />
</Base>
